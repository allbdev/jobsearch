# Port the API listens on. `apps/web` reaches it at API_URL, which defaults to
# http://localhost:3001 in apps/web/.env.example — keep the two in step.
API_PORT=3001

# Postgres. Same database the worker writes to; the API only reads it.
DATABASE_URL="postgresql://jobsearch:jobsearch@localhost:5433/jobsearch?schema=public"

# Where links in emails point: the web app (D15).
WEB_URL=http://localhost:3000

# Transactional email via Resend. Leave the key empty in development and emails
# are printed to the console instead of sent. EMAIL_FROM must be on a domain
# verified in Resend; onboarding@resend.dev only delivers to your own account.
RESEND_API_KEY=
EMAIL_FROM=
