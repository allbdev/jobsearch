# Local secrets for the worker. Copy to `apps/worker/.env` and fill in.
#
# This file is tracked; `.env` is not (CLAUDE.md 1.8). `scripts/worktree.sh
# new` copies the primary checkout's `.env` into every new worktree, so set a
# value once here and every worktree inherits it.
#
# Anything already exported in the shell wins over these.

# Postgres, matching docker-compose.yml. Port 5433, not the default 5432.
DATABASE_URL="postgresql://jobsearch:jobsearch@localhost:5433/jobsearch?schema=public"

# Used by the LLM eligibility pass (PLAN.md §4), which runs only on the
# postings the deterministic rules leave as `needs_check`.
ANTHROPIC_API_KEY=
