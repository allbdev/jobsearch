# Absolute origin of the deployed site.
#
# Read at BUILD time (it is a NEXT_PUBLIC_ variable and the landing pages are
# prerendered), so it must be set in the build environment, not just at
# runtime. Without it, hreflang and canonical URLs are emitted against
# http://localhost:3000 and Google ignores them.
NEXT_PUBLIC_SITE_URL=https://jobsearch.example

# Base URL of the API service (apps/api). Set it to sign in and see real
# feeds. Unset, the screens render fixtures -- useful for UI work with no
# API running.
#
# In production the web must sit behind a proxy that *overwrites*
# X-Forwarded-For (Vercel does): the header is forwarded to the API for its
# per-IP rate limits, and a client-supplied one would otherwise pass through.
# API_URL=http://localhost:3001
