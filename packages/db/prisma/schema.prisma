// The ingestion pipeline's tables (PLAN.md §4).
//
// The pipeline is four stages, each idempotent and independently replayable:
//
//   fetch → rawPostings → normalize → jobs → classify → jobEligibility → match
//
// That shape is why several columns exist that would otherwise look redundant.
// `rawPostings` keeps the source's original response forever, so improving the
// normaliser or the classifier is a re-run over stored data rather than a
// re-crawl. The version stamps -- `classifierVersion`, `taxonomyVersion`,
// `embeddingModel` -- are what identify which rows a given improvement
// invalidated.
//
// The user-side tables (profiles, feeds, matches, digests) land with M3.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Enums ───────────────────────────────────────────────────────────────────
// Values mirror the Zod schemas in @jobsearch/shared exactly, so nothing has to
// translate between the wire format and the database.

enum SourceKind {
  ats
  aggregator
  vertical
  community
}

enum EligibilityVerdict {
  confirmed
  needs_check
  rejected
}

enum ContractModel {
  contractor_pj
  eor
  local_entity
  employee_relocation
  unknown
}

// ─── Sources ─────────────────────────────────────────────────────────────────

model Source {
  id        String     @id @default(cuid())
  kind      SourceKind
  /// Stable slug, e.g. "greenhouse", "remoteok". Referenced in code and logs.
  slug      String     @unique
  name      String
  /// Per-source settings: base URL, board list, rate limit. Shapes differ too
  /// much between an ATS and an RSS feed to be worth normalising.
  config    Json       @default("{}")
  enabled   Boolean    @default(true)

  pollIntervalMinutes Int       @default(60)
  lastPolledAt        DateTime?
  /// Consecutive failures. A source that quietly stops returning results is
  /// how an index rots without anyone noticing (PLAN.md §7).
  failureStreak       Int       @default(0)
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawPostings RawPosting[]

  @@map("sources")
}

// ─── Companies ───────────────────────────────────────────────────────────────

model Company {
  id         String  @id @default(cuid())
  name       String
  /// Canonical host, e.g. "layered.com". The dedup key across sources: the same
  /// company arrives as "Layered", "Layered Inc." and "layered".
  domain     String? @unique
  atsType    String?
  careersUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([name])
  @@map("companies")
}

// ─── Stage 1: fetch ──────────────────────────────────────────────────────────

model RawPosting {
  id String @id @default(cuid())

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// The source's own id for this posting. With sourceId it makes re-fetching
  /// idempotent: a second fetch updates rather than duplicates.
  externalId String
  /// The response exactly as received. Never edited -- this is what makes
  /// normalize and classify replayable.
  payload    Json
  /// Hash of the meaningful payload fields, so an unchanged re-fetch is a
  /// no-op instead of a pointless normalize + classify + re-embed.
  contentHash String

  fetchedAt DateTime @default(now())

  /// The job this posting normalised into. Null means "not normalised yet",
  /// which is how the normalize stage finds its work.
  ///
  /// Many-to-one, not one-to-one: dedup is the point (PLAN.md §5). The same
  /// posting arrives from RemoteOK, We Work Remotely and the company's own
  /// Greenhouse board, and must appear once — so several raw postings share a
  /// job, and each still records which source it came from.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([jobId])
  @@index([contentHash])
  @@index([fetchedAt])
  @@map("raw_postings")
}

// ─── Stage 2: normalize ──────────────────────────────────────────────────────

model Job {
  id String @id @default(cuid())

  /// Every raw posting that normalised into this job — usually one, more when
  /// the same role was found through several sources.
  rawPostings RawPosting[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  title       String
  description String
  /// Canonicalised: tracking parameters stripped, so the same posting reached
  /// from two sources dedupes to one row.
  applyUrl    String

  /// A job family id from @jobsearch/shared (D12). Deliberately a plain string
  /// rather than a foreign key: the taxonomy is compiled in for now, and a
  /// posting classified under a family this deploy has retired must still
  /// round-trip.
  jobFamily       String?
  taxonomyVersion String?
  skills          String[] @default([])
  seniority       String?
  /// BCP-47 of the posting itself, which is often not the user's language.
  language        String?

  /// The source's own words for location, verbatim: "Hybrid", "Remote, United
  /// States", "Remote, Canada; Remote, US", "Distributed".
  ///
  /// The single highest-signal field for eligibility — 268 of the first 703
  /// postings are rejectable from this alone, without reading the description
  /// or spending an LLM call. Kept unparsed because the shapes vary per source
  /// and the classifier reads it as evidence.
  locationRaw     String?

  postedAt         DateTime
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?
  salaryPeriod     String?
  /// The source's own wording, kept because it is frequently unparseable
  /// ("competitive", "R$25-32k/mo") and still worth showing.
  salaryLabel      String?

  /// Full-text search vector, maintained by a trigger (see the migration).
  /// Prisma has no tsvector type, so it is opaque here and queried with raw SQL.
  searchVector Unsupported("tsvector")?

  /// Cohere embed-v4.0 at 1024 dimensions (D13). Null until M3 -- there is no
  /// corpus to embed before ingestion runs.
  embedding          Unsupported("vector(1024)")?
  /// Which model and size produced the vector above. Stored per row so
  /// swapping models is a filtered re-embed rather than archaeology.
  embeddingModel     String?
  embeddingDimension Int?
  embeddedAt         DateTime?

  /// Link health (PLAN.md §4). The origin prompt's "no broken links" rule.
  lastVerifiedAt DateTime?
  httpStatus     Int?
  /// Freshness cutoff; expired jobs drop out of feeds without being deleted.
  expiresAt      DateTime?

  /// Dedup key across sources: normalised company + title + canonical URL.
  contentHash String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eligibility JobEligibility?

  @@index([postedAt])
  @@index([jobFamily])
  @@index([expiresAt])
  @@index([companyId])
  @@map("jobs")
}

// ─── Stage 3: classify ───────────────────────────────────────────────────────

model JobEligibility {
  id String @id @default(cuid())

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  verdict EligibilityVerdict
  /// Human-readable region for the badge: "Worldwide", "LATAM", "Brazil listed".
  regionLabel String

  /// ISO-3166 alpha-2. Empty means unbounded rather than unknown -- `verdict`
  /// carries the unknown case.
  eligibleCountries String[] @default([])
  eligibleRegions   String[] @default([])
  contractModel     ContractModel @default(unknown)
  /// e.g. "3h overlap with EST". A preference, never a blocker: only residence
  /// and work authorisation disqualify (PLAN.md §5).
  timezoneRequirement String?

  /// The quoted line from the posting that proves eligibility. This is the
  /// product's core claim, not a nicety -- a `confirmed` verdict without one is
  /// a bug, enforced in the Zod schema and by a CHECK constraint.
  evidenceSnippet String?
  evidenceUrl     String?

  /// Which classifier produced this. Improving the prompt means re-running
  /// classify over stored raw payloads; this identifies what is stale.
  classifierVersion String
  /// Whether the deterministic keyword pass settled it, or the LLM was needed.
  /// Watching this ratio is how the classification cost stays predictable.
  decidedByRules Boolean @default(false)

  classifiedAt DateTime @default(now())

  @@index([verdict])
  @@index([classifierVersion])
  @@map("job_eligibility")
}

// ─── Taxonomy feedback (D12) ─────────────────────────────────────────────────

model UnmatchedTerm {
  id String @id @default(cuid())

  /// A role or title that matched no job family, lowercased and trimmed.
  term        String  @unique
  occurrences Int     @default(1)
  /// "posting" or "profile" -- a term users type about themselves carries more
  /// weight than one scraped from a job board.
  origin      String
  /// Set once a term has been folded into a family's aliases, so it stops
  /// showing up as a candidate without losing the count.
  resolvedTo  String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([occurrences])
  @@map("unmatched_terms")
}

// ─── Accounts (M3) ───────────────────────────────────────────────────────────

enum OAuthProvider {
  google
  github
}

enum AuthTokenPurpose {
  verify_email
  reset_password
}

enum ProfileSeniority {
  junior
  mid
  senior
  staff_plus
}

enum DigestCadence {
  daily
  weekly
  off
}

model User {
  id String @id @default(cuid())

  /// Lowercased on write. The natural key a person types, so it is unique here
  /// rather than on the profile -- an account exists before a profile does.
  email           String    @unique
  emailVerifiedAt DateTime?
  name            String?

  /// argon2id, including its parameters. Null for an account that has only
  /// ever signed in with Google or GitHub -- which is a normal account, not a
  /// half-made one.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  feeds         Feed[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]
  authTokens    AuthToken[]

  @@map("users")
}

/// What a user is looking for, and the one thing that can disqualify a match.
///
/// Separate from `User` because they answer different questions and change at
/// different rates: an account is identity, a profile is intent. A user with no
/// profile yet is a normal state, not a broken row.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ISO 3166-1 alpha-2. The only blocking field: per PLAN.md §5 nothing but
  /// residence and work authorisation can disqualify a match, and timezone
  /// overlap is a preference.
  residenceCountry String
  /// IANA, e.g. "America/Sao_Paulo". Ranks, never blocks.
  timezone         String

  /// Region codes from `REGION_VOCABULARY` in @jobsearch/core -- the same
  /// vocabulary `job_eligibility.eligibleRegions` speaks, because matching is
  /// the intersection of the two and #31 is what happens when they diverge.
  targetRegions String[] @default([])
  /// BCP-47.
  languages     String[] @default([])
  /// Job family ids from @jobsearch/shared. Plain strings for the same reason
  /// `jobs.jobFamily` is: the taxonomy is compiled in, and a retired family
  /// must still round-trip.
  jobFamilies   String[] @default([])
  targetRoles   String   @default("")
  skills        String[] @default([])

  /// Deliberately a coarser ladder than `jobs.seniority`, which records what a
  /// posting's title said (intern, associate, principal, lead, ...). A person
  /// picks from four buckets; a posting says whatever it says. Matching maps
  /// one onto the other, and conflating them would either force users through a
  /// nine-item picker or throw away what the title stated.
  seniority ProfileSeniority @default(mid)

  contractModels  ContractModel[] @default([])
  /// Minor units, to avoid float money. Null means unstated, not zero.
  minCompensation Int?
  currency        String          @default("USD")

  /// Durable interface language. It does not drive the current page -- with
  /// locale-prefixed routes the URL is the language (D11) -- it is what picks a
  /// locale for a signed-in user arriving without a prefix, which a cookie
  /// cannot do across devices.
  interfaceLanguage String @default("en")

  digestCadence  DigestCadence @default(weekly)
  /// Day of week for a weekly digest, and local send time. Stored as written
  /// rather than as a cron expression: the digest worker owns that translation,
  /// and a user setting should be readable in the row.
  digestSendOn   String        @default("monday")
  digestSendAt   String        @default("08:00")
  digestLanguage String        @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Matching filters on residence before anything else.
  @@index([residenceCountry])
  @@map("profiles")
}

/// A saved query over the global index (D1): which jobs to show, not a copy of
/// them. A user may keep several, and matching runs the definition at read time,
/// so a feed never goes stale and never needs a backfill when the index grows.
///
/// The fields mirror `feedDefinitionSchema` in @jobsearch/shared.
model Feed {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  /// Job family ids from @jobsearch/shared. Empty means any family.
  jobFamilies    String[]        @default([])
  /// Region codes from `REGION_VOCABULARY` in @jobsearch/core, the vocabulary
  /// `job_eligibility.eligibleRegions` speaks, so the filter is an array overlap.
  /// Empty means no region filter beyond the owner's residence.
  eligibleFrom   String[]        @default([])
  /// Empty means any contract model.
  contractModels ContractModel[] @default([])

  /// Minor units, as on `Profile`. Null means no floor.
  minCompensation Int?
  currency        String @default("USD")

  /// Only jobs first seen within this many days. Null means any age, and is the
  /// default: per D14 a job is shown for as long as it can be applied to, and an
  /// age cutoff hid 96 of the 251 postings a Brazilian could apply to. The field
  /// stays for a user who asks for recent jobs only; it is not imposed.
  freshnessDays Int?
  /// `needs_check` always shows, in its own tier. This only governs `rejected`.
  hideRejected  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every read of a feed is by its owner.
  @@index([userId])
  @@map("feeds")
}

// ─── Auth (D15) ──────────────────────────────────────────────────────────────

/// A signed-in browser.
///
/// The token itself is never stored: `id` is its SHA-256, so a leaked backup or
/// a stray `SELECT` yields nothing that can be replayed as a cookie. Opaque and
/// server-side rather than a JWT, because signing out, resetting a password
/// and "sign out everywhere" all have to take effect immediately, and a
/// stateless token cannot be revoked before it expires.
model Session {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sliding: extended when a request arrives in the second half of its life.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A Google or GitHub identity linked to a user.
///
/// Keyed by the provider's stable subject id, never by email: a provider email
/// can change, and one person can hold the same address on both providers.
model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String

  createdAt DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A single-use link sent by email: verify an address, or reset a password.
///
/// Stored as a hash for the same reason as sessions. `usedAt` rather than a
/// delete, so a second click on the same link can say "already used" instead of
/// "invalid", which is the difference between a confused user and a support
/// ticket.
model AuthToken {
  id      String           @id
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose AuthTokenPurpose

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@map("auth_tokens")
}
